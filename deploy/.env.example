# Copy to deploy/.env on the VPS (setup-server.sh does this and fills the passwords).
# Never commit the real .env file.

# Database passwords (generated automatically by setup-server.sh)
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# First admin login. Set ADMIN_BOOTSTRAP_ENABLED=true for the first start only,
# then set it back to false and remove ADMIN_PASSWORD.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false only while testing over plain http://<server-ip> before HTTPS is enabled.
SESSION_COOKIE_SECURE=true

# Enquiry notification emails (enquiries are always saved in the admin inbox).
ENQUIRY_EMAIL_ENABLED=false
ENQUIRY_EMAIL_TO=hello@clarigence.in
ENQUIRY_EMAIL_FROM=
SMTP_HOST=
# Port 587: SMTP_SSL=false, SMTP_STARTTLS=true. Port 465: SMTP_SSL=true, SMTP_STARTTLS=false.
SMTP_PORT=587
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
