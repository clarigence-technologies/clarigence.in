# Configure privately in Vercel Project Settings > Environment Variables.
# Confirm the SMTP host and port in your mailbox provider's settings.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=hello@clarigence.in
SMTP_PASSWORD=
# Optional authorized sender; defaults to SMTP_USERNAME.
ENQUIRY_EMAIL_FROM=hello@clarigence.in
